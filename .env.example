# Runtime
NODE_ENV=development

# Public application URL used by Better Auth callback configuration.
BETTER_AUTH_URL=http://localhost:3000
# Optional browser override when the frontend and API use different origins.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# PostgreSQL connection string. Use a local or test database; never commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financas_gomes

# Optional separate target for a controlled deploy migration. If empty, the
# migration commands use DATABASE_URL. Preview can set its own URL directly.
MIGRATION_DATABASE_URL=

# Defaults consumed by docker compose for the local PostgreSQL service.
POSTGRES_DB=financas_gomes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_TEST_DB=financas_gomes_test
POSTGRES_TEST_PORT=5433
APP_PORT=3000

# Dedicated database used by Playwright. Do not point E2E_DATABASE_URL at a
# shared or production database; the smoke flow creates its fake user/context.
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/financas_gomes_test

# Generate a unique value with at least 32 characters for each environment.
BETTER_AUTH_SECRET=replace-me-with-a-random-secret-at-least-32-characters

# Google OAuth credentials for the V1 authentication flow.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Local Playwright only. The app additionally requires NODE_ENV=development
# and rejects this provider when VERCEL_ENV is preview/production.
E2E_TEST_AUTH_ENABLED=false
E2E_TEST_AUTH_EMAIL=e2e-auth@example.test
E2E_TEST_AUTH_NAME=E2E Google User

# Optional lifetime for copyable household invite links, in seconds (7 days).
HOUSEHOLD_INVITE_TTL_SECONDS=604800

# Optional Sentry configuration. Leave SENTRY_DSN empty when observability is disabled locally.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Public DSN/settings used by the browser bundle. A Sentry DSN is safe to
# expose, but keep the server DSN above separate from client configuration.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=

# Optional controlled probe. Keep disabled outside a short validation window.
SENTRY_TEST_MODE=false
SENTRY_TEST_TOKEN=
